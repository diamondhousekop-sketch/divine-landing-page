# ══════════════════════════════════════════════════════════════════════════
# Diamond House — environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# ══════════════════════════════════════════════════════════════════════════

# ─── Supabase (public, client-safe — VITE_ prefix is exposed to the browser) ───
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Supabase (SERVER ONLY — must NEVER be VITE_ prefixed / never in client bundle) ───
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Razorpay ───
# Optional at deploy time — COD works without these. You can also set/change
# these later from the Admin panel (Content → Payments), which stores them in
# the admin_settings table (service-role only, never sent to the browser).
RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ─── Resend (SERVER ONLY) ───
# RESEND_FROM_EMAIL must be a verified domain sender in your Resend account.
# Use onboarding@resend.dev only for sandbox testing (delivers to your own account email).
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=team@yourdomain.com
ADMIN_ALERT_EMAIL=team@yourdomain.com

# ─── Site ───
SITE_URL=https://yourdomain.com
